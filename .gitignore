# This repository is one WordPress plugin: PHP, vanilla JavaScript and CSS.
# There is no build step and no package manager, so there is very little to
# ignore. The Next.js/Vercel ignore list this replaced described a stack that
# no longer exists here.

# Build output from tools/build-release.sh
/dist/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Local environment and secrets — never in a repository that holds a plugin
# people will copy onto a live church site.
.env*
*.pem

# Local WordPress noise, in case anyone develops in place
wp-config.php
debug.log
mail.log

# Local Claude Code permissions — machine-specific XAMPP paths.
.claude/settings.local.json
